# Local development settings for event-service. Copy to .env in this directory.
PORT=4002
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=techcollab
DB_PASSWORD=change-me
DB_DATABASE=techcollab
# Auto-create/update tables from the entities (disable once you add migrations)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Must be identical across all backend services
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
