# Copy to .env and fill in real values: cp .env.example .env
# docker compose reads this file; the services also read it when run locally
# (see each package's .env.example for per-service development defaults).

# --- Postgres (shared by all backend services) ---
POSTGRES_USER=techcollab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=techcollab

# --- Authentication ---
# Shared by every backend service: user-service signs tokens with it and the
# other services verify them. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# --- CORS: comma-separated list of browser origins allowed to call the APIs ---
CORS_ORIGIN=http://localhost:3000

# --- Public URLs the browser uses to reach each API (baked into the frontend build) ---
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:4000
NEXT_PUBLIC_FREELANCE_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_EVENT_SERVICE_URL=http://localhost:4002
